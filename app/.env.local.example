# Copy to .env.local and fill in. Server-only: never prefix with NEXT_PUBLIC_.
# Both values come from the Supabase dashboard under Project Settings > API.
# Use a secret key (sb_secret_...), not the publishable key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Direct Postgres connection string from Supabase Dashboard → Connect.
# Used only by `npm run migrate`; never expose it to the browser.
SUPABASE_DB_URL=
ADMIN_PASSWORD=
